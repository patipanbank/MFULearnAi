# Server Configuration
PORT=3001
APP_ENV=production
LOG_LEVEL=info

# MongoDB Configuration
MONGODB_URI=mongodb://root:1234@mongodb:27017/mfu_chatbot?authSource=admin

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Frontend URLs
DEV_FRONTEND_URL=http://localhost:5173
PROD_FRONTEND_URL=https://mfulearnai.mfu.ac.th
DEV_ALLOWED_ORIGINS=http://localhost:5173
PROD_ALLOWED_ORIGINS=https://mfulearnai.mfu.ac.th

# SAML Configuration
SAML_SP_ENTITY_ID=https://mfulearnai.mfu.ac.th/api/auth/metadata
SAML_SP_ACS_URL=https://mfulearnai.mfu.ac.th/api/auth/saml/callback
SAML_IDP_SSO_URL=https://your-idp-server/sso
SAML_IDP_SLO_URL=https://your-idp-server/slo
SAML_IDP_ENTITY_ID=https://your-idp-server/metadata
SAML_CERTIFICATE=your-idp-certificate-here
SAML_IDENTIFIER_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified

# Department Service URL (for inter-service communication)
DEPARTMENT_SERVICE_URL=http://department-service:3002
