apiVersion: v1
kind: Secret
metadata:
  name: auth-service-secrets
  namespace: mfulearnai
  labels:
    app: auth-service
type: Opaque
stringData:
  mongodb-uri: "mongodb://root:1234@mongodb:27017/mfu_chatbot?authSource=admin"
  jwt-secret: "your-jwt-secret-key-change-in-production"
  session-secret: "your-session-secret-change-in-production"
  saml-idp-sso-url: "https://your-idp-server/sso"
  saml-idp-slo-url: "https://your-idp-server/slo"
  saml-idp-entity-id: "https://your-idp-server/metadata"
  saml-certificate: |
    -----BEGIN CERTIFICATE-----
    YOUR_IDP_CERTIFICATE_HERE
    -----END CERTIFICATE-----
