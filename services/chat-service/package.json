{
  "name": "chat-service",
  "version": "1.0.0",
  "description": "LangChain + LangGraph based chat microservice",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc --noEmitOnError false || true",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "chat",
    "microservice",
    "ai",
    "agent"
  ],
  "author": "MFU Learn AI",
  "license": "MIT",
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/aws": "^0.1.0",
    "@langchain/openai": "^0.6.0",
    "@langchain/anthropic": "^0.3.0",
    "@langchain/community": "^0.3.0",
    "langchain": "^0.3.0",
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "ioredis": "^5.4.1",
    "pg": "^8.13.1",
    "mongoose": "^8.8.4",
    "pgvector": "^0.2.0",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.13.3",
    "winston": "^3.17.0",
    "prom-client": "^15.1.3",
    "dotenv": "^16.4.7",
    "uuid": "^11.0.3",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/express": "^5.0.0",
    "@types/ws": "^8.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^10.0.0",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "typescript": "^5.7.2",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "supertest": "^7.0.0",
    "eslint": "^9.17.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
