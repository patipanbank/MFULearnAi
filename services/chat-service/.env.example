# Server Configuration
NODE_ENV=production
APP_ENV=production
PORT=5002

# Database - Redis
REDIS_URL=redis://redis-service:6379
REDIS_HOST=redis-service
REDIS_PORT=6379
REDIS_PASSWORD=

# Database - PostgreSQL
POSTGRES_URL=postgresql://user:password@postgres-service:5432/chat_service
POSTGRES_HOST=postgres-service
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=chat_service

# Database - MongoDB
MONGODB_URI=mongodb://root:1234@mongodb-service:27017/mfu_chatbot?authSource=admin

# JWT Authentication
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# OpenAI (Optional)
OPENAI_API_KEY=your-openai-api-key

# External Services
AUTH_SERVICE_URL=http://auth-service:5001
RAG_SERVICE_URL=http://rag-service:5003
AGENT_SERVICE_URL=http://agent-service:5004

# Frontend
FRONTEND_URL=https://mfulearnai.mfu.ac.th
PROD_FRONTEND_URL=https://mfulearnai.mfu.ac.th
CORS_ORIGIN=https://mfulearnai.mfu.ac.th

# Chat Configuration
MAX_CONCURRENT_CHATS=100
STREAM_TIMEOUT_MS=300000
MAX_MESSAGE_LENGTH=10000
MAX_ITERATIONS=5
CHECKPOINT_TTL_SECONDS=3600

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
