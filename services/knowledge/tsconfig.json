{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": "./",
        "paths": {
            "../shared/types": [
                "./shared/types",
                "../../../shared/types"
            ]
        }
    },
    "include": [
        "**/*.ts",
        "shared/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}