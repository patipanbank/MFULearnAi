# ==============================================
# MFULearnAI Frontend Environment Variables
# ==============================================
# Copy this file to .env and update the values
# ==============================================

# API Configuration
# For development: Point to local backend monolith
# For production: Point to API Gateway
VITE_API_URL=http://localhost:3001/api

# WebSocket Configuration
# Must match the API URL protocol (ws:// for http://, wss:// for https://)
VITE_WS_URL=ws://localhost:3001/ws

# ==============================================
# Production Example:
# ==============================================
# VITE_API_URL=https://mfulearnai.mfu.ac.th/api
# VITE_WS_URL=wss://mfulearnai.mfu.ac.th/ws
