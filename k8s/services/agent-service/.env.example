# Node Environment
NODE_ENV=production
PORT=3003

# MongoDB
MONGODB_URI=mongodb://mongodb:27017/mfulearnai

# Service URLs (Kubernetes internal DNS)
RAG_SERVICE_URL=http://rag-service.mfulearnai-services.svc.cluster.local:3004
STORAGE_SERVICE_URL=http://storage-service.mfulearnai-services.svc.cluster.local:3006
BEDROCK_SERVICE_URL=http://bedrock-gateway.mfulearnai-services.svc.cluster.local:8000

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# Anthropic API (optional, if using direct Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (optional, if using OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Google Search (optional, for web search tool)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here
