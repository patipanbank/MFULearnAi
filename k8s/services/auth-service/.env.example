NODE_ENV=production
PORT=3000
LOG_LEVEL=info
MONGODB_URI=mongodb://root:1234@mongodb.mfulearnai-core.svc.cluster.local:27017/mfu_chatbot?authSource=admin
REDIS_URL=redis://redis.mfulearnai-core.svc.cluster.local:6379
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
SESSION_SECRET=your-session-secret-here
FRONTEND_URL=https://mfulearnai.mfu.ac.th
SAML_SP_ENTITY_ID=https://mfulearnai.mfu.ac.th
SAML_SP_ACS_URL=https://mfulearnai.mfu.ac.th/api/auth/saml/callback
SAML_IDP_SSO_URL=https://idp.mfu.ac.th/sso
SAML_IDP_SLO_URL=https://idp.mfu.ac.th/slo
SAML_IDP_ENTITY_ID=https://idp.mfu.ac.th
SAML_CERTIFICATE=your-certificate-here
SAML_IDENTIFIER_FORMAT=urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified
DEPARTMENT_SERVICE_URL=http://department-service.mfulearnai-services.svc.cluster.local:3001
