{
    "compilerOptions": {
        "target": "es2018",
        "module": "commonjs",
        "outDir": "./dist",
        "rootDir": "../",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "typeRoots": [
            "./node_modules/@types"
        ]
    },
    "ts-node": {
        "files": true,
        "transpileOnly": true
    },
    "include": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "../shared/**/*.ts"
    ]
}