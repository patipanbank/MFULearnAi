# MFU Learn AI - Admin Creation Environment Variables
# Copy this file to .env or export these variables before running the script

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Production MongoDB URI (as seen in docker-compose.yml)
MONGODB_URI=mongodb://root:1234@db:27017/mfu_chatbot?authSource=admin

# For local development or direct server connection:
# MONGODB_URI=mongodb://root:1234@localhost:27017/mfu_chatbot?authSource=admin

# =============================================================================
# ADMIN USER CONFIGURATION
# =============================================================================
# Admin credentials
ADMIN_USERNAME=superadmin
ADMIN_PASSWORD=SecurePassword123!
ADMIN_EMAIL=superadmin@mfu.ac.th
ADMIN_FIRSTNAME=System
ADMIN_LASTNAME=Administrator

# Department (should match your organization structure)
ADMIN_DEPARTMENT=IT

# Role options: Admin, SuperAdmin
# Admin: Department management permissions
# SuperAdmin: Full system administration + usage management
ADMIN_ROLE=SuperAdmin

# =============================================================================
# DERIVED FROM EXISTING .env FILE
# =============================================================================
# These values come from your production environment:
# APP_ENV=production
# JWT_SECRET=cd343ae6f65f6b6e164289b860c89442edc01c7c8ef327d3959e56d542fffbc15065cd1e88e10c8e15754997d252aaedfde3a38a3733f55dcdabfdcf1e27098a
# AWS_REGION=us-east-1
# NGINX_SERVER_NAME=mfulearnai.mfu.ac.th

# =============================================================================
# USAGE EXAMPLES
# =============================================================================

# Method 1: Use existing .env file
# The script will automatically read from your main .env file if MONGODB_URI is not set

# Method 2: Copy and customize this file
# cp create_admin_env.example .env.admin
# nano .env.admin
# source .env.admin
# ./create_admin.sh

# Method 3: Export specific variables
# export MONGODB_URI="mongodb://root:1234@localhost:27017/mfu_chatbot?authSource=admin"
# export ADMIN_USERNAME="superadmin"
# export ADMIN_PASSWORD="YourSecurePassword123!"
# export ADMIN_EMAIL="superadmin@mfu.ac.th"
# export ADMIN_ROLE="SuperAdmin"
# ./create_admin.sh

# Method 4: Docker environment (if running inside container)
# export MONGODB_URI="mongodb://root:1234@db:27017/mfu_chatbot?authSource=admin"
# node create_admin.js

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Use strong passwords (min 12 characters, mixed case, numbers, symbols)
# 2. Set appropriate file permissions: chmod 600 .env.admin
# 3. Don't commit admin credentials to git
# 4. Rotate credentials regularly
# 5. Use department-specific emails where possible